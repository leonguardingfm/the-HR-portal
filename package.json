{
  "name": "the-hr-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Recruitment and Vetting portal for a security company, with BS 7858:2019 screening built into the workflow",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:permissions && npm run db:test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:test": "bash scripts/test-constraints.sh",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-generate && npm run db:seed",
    "test:permissions": "tsx scripts/test-permissions.ts",
    "sweep:clocks": "tsx --env-file-if-exists=.env scripts/sweep-screening-clocks.ts",
    "sweep:duty": "tsx --env-file-if-exists=.env scripts/sweep-duty.ts",
    "demo:duty": "tsx --env-file-if-exists=.env scripts/demo-duty.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^16.3.5",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "postcss": "^8.5.28",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.9"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  }
}
