# The database. Required to run; the four database-backed routes will error
# without it. Everything else still renders.
DATABASE_URL="postgresql://user:password@localhost:5432/leon"

# Signs the session cookie. Must be at least 16 characters, and must be set in
# production — the app refuses to start without it there.
AUTH_SECRET="change-me-to-a-long-random-string"

# Web push — the phone and desktop alerts for officers and Control.
# Generate a pair once with: npx web-push generate-vapid-keys
# The subject is a contact address the push services can reach the company on.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:control@your-company.example"

# The background worker runs the duty checks every 30 seconds inside the server.
# Set to "off" where an outside scheduler runs `npm run sweep:duty` instead.
DUTY_WORKER=""

# The portal's address, used in the links emailed to candidates and referees.
APP_URL="https://portal.your-company.example"

# Email out: application links, reminders, interview invitations, reference
# requests. Without these, emails are kept in the portal with their links, not sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Leon Guarding HR <hr@your-company.example>"

# The Performance hub's AI (Anthropic). Without a key, incoming emails are sorted
# by the portal's rules and marked for a person to check. Optional model override.
ANTHROPIC_API_KEY=""
HUB_AI_MODEL="claude-sonnet-5"
